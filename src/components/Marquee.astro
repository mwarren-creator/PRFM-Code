---
const items = ['ORGANIZATIONS', 'EVENTS', 'FACILITIES', 'ATHLETE PATHWAYS', 'SPONSORSHIPS', 'SPORTS TECHNOLOGY'];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee-inner">
    {items.map((item) => (
      <span class="marquee-item">
        {item}
        <span class="marquee-dot">&#9642;</span>
      </span>
    ))}
    {items.map((item) => (
      <span class="marquee-item" aria-hidden="true">
        {item}
        <span class="marquee-dot">&#9642;</span>
      </span>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: var(--cream);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 0;
  }

  .marquee-inner {
    display: flex;
    white-space: nowrap;
    animation: marquee 32s linear infinite;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .marquee-item {
    font-family: 'Archivo Black', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    padding: 0 1.75rem;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .marquee-dot {
    color: var(--orange);
    font-size: 0.55rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-inner {
      animation: none;
    }
  }
</style>
