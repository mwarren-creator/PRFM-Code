---
interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow = "WHAT'S NEXT",
  heading = "LET'S BUILD WHAT'S NEXT IN SPORTS",
  description = 'Whether you are improving an organization, launching an event, developing a facility or helping an athlete reach the next level, PRFM Sports can help turn your vision into a sustainable plan.',
  primaryLabel = 'SCHEDULE A CONSULTATION',
  primaryHref = '/contact',
  secondaryLabel = 'CONTACT PRFM SPORTS',
  secondaryHref = 'mailto:info@prfmsports.com',
} = Astro.props;
---

<section class="cta">
  <div class="cta-inner">
    <p class="cta-eyebrow">{eyebrow}</p>
    <h2 class="cta-heading">{heading}</h2>
    <p class="cta-desc">{description}</p>
    <div class="cta-actions">
      <a href={primaryHref} class="cta-btn cta-btn--primary">{primaryLabel}</a>
      <a href={secondaryHref} class="cta-btn cta-btn--secondary">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--ink);
    color: white;
  }

  .cta-inner {
    margin: 0 auto;
    padding: 7rem 5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 4rem;
    align-items: center;
  }

  .cta-eyebrow {
    grid-column: 1 / -1;
    font-family: 'Archivo Black', sans-serif;
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    color: var(--orange);
  }

  .cta-heading {
    font-family: 'Archivo Black', sans-serif;
    font-weight: 900;
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .cta-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.65);
    max-width: 400px;
    align-self: center;
  }

  .cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-self: center;
  }

  .cta-btn {
    font-family: 'Archivo Black', sans-serif;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    padding: 0.75rem 1.75rem;
    display: inline-block;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .cta-btn--primary {
    background: var(--orange);
    color: #0f1014;
  }

  .cta-btn--primary:hover {
    background: #b8f020;
  }

  .cta-btn--secondary {
    border: 1.5px solid rgba(255,255,255,0.35);
    color: rgba(255,255,255,0.85);
  }

  .cta-btn--secondary:hover {
    border-color: rgba(255,255,255,0.7);
    color: #fff;
  }

  @media (max-width: 768px) {
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 4rem 1.5rem;
    }

    .cta-eyebrow {
      grid-column: 1;
    }
  }
</style>
