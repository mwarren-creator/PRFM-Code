---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="404 — PRFM Sports">
  <Nav />
  <main class="notfound">
    <span class="notfound-code">404</span>
    <p class="notfound-msg">Oops! Page not found</p>
    <a href="/" class="notfound-link">Return to Home</a>
  </main>
  <Footer />
</Base>

<style>
  .notfound {
    min-height: 60vh;
    padding-top: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
  }

  .notfound-code {
    font-family: 'Archivo Black', sans-serif;
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--ink);
  }

  .notfound-msg {
    font-size: 1.1rem;
    color: var(--muted);
  }

  .notfound-link {
    font-family: 'Archivo Black', sans-serif;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    padding: 0.85rem 2rem;
    background: var(--orange);
    color: #0f1014;
    margin-top: 0.5rem;
    transition: background 0.2s;
  }

  .notfound-link:hover {
    background: #b8f020;
  }
</style>
