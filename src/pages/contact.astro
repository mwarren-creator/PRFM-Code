---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Footer from '../components/Footer.astro';

const helpItems = [
  'Youth Sports Consulting & Management',
  'Youth Sports Event Management',
  'Athlete Advisory & College Recruiting',
  'Sports Properties Management',
  'Something else',
];
---

<Base
  title="Contact PRFM Sports | Work With PRFM"
  description="Tell us what you're building — an organization, an event, a facility or an athlete pathway — and we'll follow up to schedule a consultation."
>
  <Nav />
  <main>
    <ServiceHero
      label="CONTACT"
      title="WORK WITH PRFM"
      subheading="Schedule a Consultation"
      paragraphs={[
        "Tell us what you're building — an organization, an event, a facility or an athlete pathway — and we'll follow up to schedule a consultation.",
      ]}
    />

    <section class="contact-cards">
      <div class="contact-card">
        <h2 class="card-heading">GET IN TOUCH</h2>
        <a href="mailto:info@prfmsports.com" class="contact-email">info@prfmsports.com</a>
        <div class="contact-socials">
          <a href="https://www.instagram.com/prfmsports/" aria-label="PRFM Sports on Instagram" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="https://www.linkedin.com/company/prfmsports" aria-label="PRFM Sports on LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
        </div>

        <h3 class="help-heading">HOW WE CAN HELP</h3>
        <ul class="help-list">
          {helpItems.map(item => <li>{item}</li>)}
        </ul>
      </div>

      <div class="contact-card contact-card--dark">
        <h2 class="card-heading">START THE CONVERSATION</h2>
        <p class="card-desc">
          Email us with a few details — your organization, facility or athlete, what you're trying to accomplish and your timeline — and we'll respond with next steps.
        </p>
        <a href="mailto:info@prfmsports.com?subject=PRFM%20Sports%20Consultation%20Request" class="contact-cta">EMAIL PRFM SPORTS</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .contact-cards {
    margin: 0 auto;
    padding: 0 5rem 6rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .contact-card {
    background: var(--cream);
    padding: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-card--dark {
    background: var(--ink);
    color: white;
    justify-content: center;
  }

  .card-heading {
    font-family: 'Archivo Black', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    color: inherit;
  }

  .contact-email {
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--ink);
  }

  .contact-socials {
    display: flex;
    gap: 1rem;
    color: var(--muted);
  }

  .contact-socials a {
    color: inherit;
    display: flex;
    transition: color 0.2s;
  }

  .contact-socials a:hover {
    color: var(--ink);
  }

  .help-heading {
    font-family: 'Archivo Black', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--ink);
    margin-top: 1rem;
  }

  .help-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .help-list li {
    font-size: 0.95rem;
    color: var(--muted);
    padding-left: 1rem;
    position: relative;
  }

  .help-list li::before {
    content: '\25AA';
    position: absolute;
    left: 0;
    color: var(--orange);
    font-size: 0.6rem;
    top: 0.35rem;
  }

  .card-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.65);
  }

  .contact-cta {
    align-self: flex-start;
    font-family: 'Archivo Black', sans-serif;
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    padding: 0.85rem 2rem;
    background: var(--orange);
    color: #0f1014;
    transition: background 0.2s;
  }

  .contact-cta:hover {
    background: #b8f020;
  }

  @media (max-width: 900px) {
    .contact-cards {
      grid-template-columns: 1fr;
      padding: 0 1.5rem 4rem;
    }
  }
</style>
